{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoglobe.si/schema/v0/polity.schema.json",
  "title": "Polity",
  "description": "A state, empire, people, or other polity, dated by earliest and latest year bounds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "earliest", "latest", "sources", "confidence"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "name": {"type": "string", "minLength": 1},
    "kind": {"enum": ["state", "empire", "people", "other"]},
    "earliest": {
      "description": "Inclusive start year. Negative years are BCE. -1 is 1 BCE.",
      "type": "integer"
    },
    "latest": {
      "description": "Inclusive end year. Negative years are BCE.",
      "type": "integer"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "confidence": {
      "description": "Exactly one label.",
      "enum": [
        "attested",
        "scholarly-consensus",
        "estimate",
        "reconstructed",
        "contested",
        "legendary"
      ]
    },
    "low": {"description": "Required, with high and method, when confidence is estimate.", "type": "number"},
    "high": {"type": "number"},
    "method": {"type": "string", "minLength": 1},
    "alternatives": {"$ref": "https://chronoglobe.si/schema/v0/common.schema.json#/$defs/alternatives"},
    "example": {"type": "boolean"},
    "note": {"type": "string"}
  }
}
