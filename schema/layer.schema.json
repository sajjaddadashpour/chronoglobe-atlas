{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoglobe.si/schema/v0/layer.schema.json",
  "title": "Layer value",
  "description": "One population, GDP, climate, or governance value, with a low, a high, a unit, a method, and source ids. The layer field must match the directory under layers/.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "layer",
    "earliest",
    "latest",
    "value_low",
    "value_high",
    "unit",
    "method",
    "sources",
    "confidence"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "layer": {"enum": ["population", "gdp", "climate", "governance"]},
    "polity": {
      "description": "Polity id, when the value is about a polity. Must resolve under polities/.",
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "subject": {
      "description": "What the value measures when it is not a polity id. A label, not a reference.",
      "type": "string",
      "minLength": 1
    },
    "earliest": {"type": "integer"},
    "latest": {"type": "integer"},
    "value_low": {"type": "number"},
    "value_high": {"type": "number"},
    "unit": {"type": "string", "minLength": 1},
    "method": {"type": "string", "minLength": 1},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "confidence": {
      "enum": [
        "attested",
        "scholarly-consensus",
        "estimate",
        "reconstructed",
        "contested",
        "legendary"
      ]
    },
    "alternatives": {"$ref": "https://chronoglobe.si/schema/v0/common.schema.json#/$defs/alternatives"},
    "example": {"type": "boolean"},
    "note": {"type": "string"}
  }
}
