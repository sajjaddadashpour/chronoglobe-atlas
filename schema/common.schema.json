{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoglobe.si/schema/v0/common.schema.json",
  "title": "Shared Chronoglobe fragments",
  "description": "Referenced by the entity schemas. Not a document type of its own.",
  "$defs": {
    "slug": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "alternatives": {
      "description": "Other readings of a contested fact. Each reading cites its own sources.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sources"],
        "anyOf": [
          {"required": ["value"]},
          {"required": ["value_low"]},
          {"required": ["value_high"]},
          {"required": ["low"]},
          {"required": ["high"]}
        ],
        "properties": {
          "value": {"type": ["string", "number"]},
          "value_low": {"type": "number"},
          "value_high": {"type": "number"},
          "low": {"type": "number"},
          "high": {"type": "number"},
          "note": {"type": "string"},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "https://chronoglobe.si/schema/v0/common.schema.json#/$defs/slug"}
          }
        }
      }
    },
    "succession": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "id"],
        "properties": {
          "role": {"enum": ["predecessor", "successor", "co-ruler"]},
          "id": {"$ref": "https://chronoglobe.si/schema/v0/common.schema.json#/$defs/slug"}
        }
      }
    },
    "position": {
      "type": "array",
      "minItems": 2,
      "maxItems": 3,
      "items": {"type": "number"}
    },
    "linear-ring": {
      "type": "array",
      "minItems": 4,
      "items": {"$ref": "https://chronoglobe.si/schema/v0/common.schema.json#/$defs/position"}
    },
    "geometry": {
      "description": "One GeoJSON Polygon or MultiPolygon.",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"const": "Polygon"},
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {"$ref": "https://chronoglobe.si/schema/v0/common.schema.json#/$defs/linear-ring"}
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "coordinates"],
          "properties": {
            "type": {"const": "MultiPolygon"},
            "coordinates": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "minItems": 1,
                "items": {"$ref": "https://chronoglobe.si/schema/v0/common.schema.json#/$defs/linear-ring"}
              }
            }
          }
        }
      ]
    }
  }
}
