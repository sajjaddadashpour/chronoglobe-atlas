{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chronoglobe.si/schema/v0/capital.schema.json",
  "title": "Capital",
  "description": "A capital: one polity, one place, and the years that claim holds.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "polity", "place", "earliest", "latest", "sources", "confidence"],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "polity": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "place": {"type": "string", "minLength": 1},
    "earliest": {"type": "integer"},
    "latest": {"type": "integer"},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 80,
        "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    },
    "confidence": {
      "enum": [
        "attested",
        "scholarly-consensus",
        "estimate",
        "reconstructed",
        "contested",
        "legendary"
      ]
    },
    "low": {"type": "number"},
    "high": {"type": "number"},
    "method": {"type": "string", "minLength": 1},
    "alternatives": {"$ref": "https://chronoglobe.si/schema/v0/common.schema.json#/$defs/alternatives"},
    "example": {"type": "boolean"},
    "note": {"type": "string"}
  }
}
